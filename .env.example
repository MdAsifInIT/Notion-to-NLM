# ── Notion ──────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Docs ─────────────────────────────────────────
GOOGLE_DOC_ID=your_google_doc_id_here

# Path to the OAuth 2.0 client-secret JSON downloaded from
# Google Cloud Console.  Defaults to "credentials.json" in
# the project root.
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── State ───────────────────────────────────────────────
# File used to persist the last-processed timestamp.
# Defaults to "state.json" in the project root.
STATE_FILE=state.json

# ── Optional ────────────────────────────────────────────
# Default lookback window (hours) when no state file exists.
DEFAULT_LOOKBACK_HOURS=24

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# If set, the app runs in daemon mode and runs the sync at the specified interval (hours).
# Leave commented out or unset to run the script once and exit.
# SYNC_INTERVAL_HOURS=3

