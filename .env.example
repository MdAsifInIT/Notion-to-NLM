# ── Notion ──────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Docs ─────────────────────────────────────────
GOOGLE_DOC_ID=your_google_doc_id_here

# Path to the OAuth 2.0 client-secret JSON downloaded from
# Google Cloud Console.  Defaults to "credentials.json" in
# the project root.
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── State ───────────────────────────────────────────────
# File used to persist the last-processed timestamp.
# Defaults to "state.json" in the project root.
STATE_FILE=state.json

# ── Optional ────────────────────────────────────────────
# Default lookback window (hours) when no state file exists.
DEFAULT_LOOKBACK_HOURS=24

# Overlap the previous checkpoint by this many seconds to avoid missing edits
# near run boundaries. Reprocessed pages are upserted by Notion page ID.
STATE_SAFETY_OVERLAP_SECONDS=300

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# If set, the app runs in daemon mode and runs the sync at the specified interval (hours).
# Leave commented out or unset to run the script once and exit.
# SYNC_INTERVAL_HOURS=3

# ── Upgrades Optional Variables ──────────────────────────
# File used to persist file-based metrics. Defaults to "metrics.json".
# METRICS_FILE=metrics.json

# File used to prevent concurrent sync runs. Defaults to ".pipeline.lock".
# RUN_LOCK_FILE=.pipeline.lock

# Healthcheck marker path. Defaults to "/tmp/healthy".
# HEALTH_FILE=/tmp/healthy

# API retry and timeout settings.
# API_TIMEOUT_SECONDS=30
# API_MAX_RETRIES=5
# API_RETRY_BASE_SECONDS=1
# API_RETRY_MAX_SECONDS=60

# Maximum Google Docs batchUpdate requests per API call.
# GOOGLE_BATCH_MAX_REQUESTS=100

# Google OAuth mode: auto | console | local_server. Defaults to "auto".
# GOOGLE_AUTH_MODE=auto

# Path to the persisted Google OAuth 2.0 user credentials. Defaults to "token.json".
# TOKEN_FILE=token.json

